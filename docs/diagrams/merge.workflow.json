      { "id": "happy", "label": "主流程", "focus": ["pick", "job", "probe", "decide", "concat", "norm", "artifact"], "note": "一次合并 = 一个作业：只把锚点条目提交进并发队列，其余参与条目仅标记状态。" },
      { "id": "modes", "label": "双模式分支", "focus": ["probe", "decide", "segB", "concat", "tmpdir"], "note": "同参（编码/分辨率/帧率/采样率 + extradata 一致）零重编码直拼，否则逐段统一后再拼。" },
      { "id": "abort", "label": "取消与清理", "focus": ["concat", "cancel", "cleanup", "tmpdir"], "note": "参与条目共享同一个取消标志；清理走 remove_dir_all，无重试无上报。" },
      { "id": "issues", "label": "问题热点", "focus": ["job", "probe", "decide", "segB", "norm", "artifact", "cancel", "cleanup"], "note": "🔴 未修 / 🟡 待修 / ✅ 本轮已修，编号见节点第三行与下方卡片。" }
    ]
  },
