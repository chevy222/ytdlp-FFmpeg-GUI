    { "id": "ready", "lane": "cmd", "col": 3, "width": 150, "type": "security", "label": "就绪/倒计时", "sublabel": "item:ready 5s", "tag": "🟢 封面入缓存" },
    { "id": "playlist", "lane": "core", "col": 3, "width": 150, "type": "backend", "label": "播放列表展开", "sublabel": "flat-playlist", "tag": "✅ 条目已过滤" },
    { "id": "startq", "lane": "cmd", "col": 4, "width": 150, "type": "security", "label": "🟡 入队下载", "sublabel": "transition+submit", "tag": "P1-7 无所有权校验" },
    { "id": "args", "lane": "core", "col": 4, "width": 150, "type": "backend", "label": "✅ 组装参数", "sublabel": "7级回落 / -S", "tag": "S1 -- 终结符" },
    { "id": "dl", "lane": "proc", "col": 4, "width": 150, "type": "external", "label": "✅ yt-dlp 下载", "sublabel": "Monitored 排空", "tag": "P0-1 已修死锁" },
    { "id": "post", "lane": "core", "col": 5, "width": 150, "type": "database", "label": "🔴 后处理", "sublabel": "降分辨率+增益", "tag": "P1-4 原地覆盖" },
    { "id": "finish", "lane": "cmd", "col": 5, "width": 150, "type": "backend", "label": "🔴 收尾", "sublabel": "释放额度+落盘", "tag": "P0-3 panic 泄漏" },
    { "id": "cancel", "lane": "except", "col": 4, "width": 150, "type": "security", "label": "取消清理", "sublabel": "删本次产物", "tag": "🟡 T8 无重试" }
