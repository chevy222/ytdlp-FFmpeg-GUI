    { "id": "proc", "label": "yt-dlp 子进程" },
    { "id": "fs", "label": "文件与产物" },
    { "id": "except", "label": "取消 / 失败", "variant": "exception" }
  ],
  "phases": [
    { "id": "ph_add", "label": "添加与解析", "fromCol": 0, "toCol": 2 },
    { "id": "ph_queue", "label": "排队与参数", "fromCol": 3, "toCol": 3 },
    { "id": "ph_dl", "label": "下载与后处理", "fromCol": 4, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["add", "probe", "ytdlp", "ready", "startq", "args", "dl", "post", "finish"],
  "nodes": [
    { "id": "add", "lane": "ui", "col": 0, "width": 150, "type": "frontend", "label": "粘贴/拖放", "sublabel": "add_url / add_local" },
    { "id": "probe", "lane": "cmd", "col": 1, "width": 150, "type": "backend", "label": "🔴 解析线程", "sublabel": "run_probe", "tag": "P0-5 每条目一线程" },
