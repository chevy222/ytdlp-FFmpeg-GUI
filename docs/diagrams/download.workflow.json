      { "id": "download", "label": "下载阶段", "focus": ["startq", "args", "dl", "post", "finish"], "note": "7 级格式回落 + -S 排序 + --no-overwrites；产物路径按 ExtractAudio→Merger→Destination→已下载 收敛。" },
      { "id": "abort", "label": "取消与清理", "focus": ["dl", "cancel", "finish"], "note": "取消只删本次创建时间之后的产物与 .part/.ytdl 残留，绝不碰用户既有文件。" },
